#!/bin/sh
set -eu
unit=qcopilots-websearch.service
if [ "${1:-}" = purge ]; then
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper purge "$unit" >/dev/null || true
    fi
fi
case "${1:-}" in
    remove|purge|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null || true
        fi
        ;;
esac
# dpkg removes its conffile on purge. Generated tokens, data and the service
# account remain, preventing accidental data loss and later UID reuse.
exit 0
