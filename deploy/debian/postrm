#!/bin/sh
set -eu
unit=@QCWS_DEB_BASENAME@.service
fail() { echo "QCopilots-WebSearch: $1" >&2; exit 1; }
check_purge_directory() {
    directory=$1
    [ ! -L "$directory" ] || fail "Cannot purge through symbolic-link directory $directory."
    if [ ! -e "$directory" ]; then
        return 0
    fi
    [ -d "$directory" ] && [ "$(stat -c %u -- "$directory")" -eq 0 ] \
        || fail "Cannot purge through $directory without a real root-owned directory."
    mode=$(stat -c %a -- "$directory")
    [ "$((0$mode & 0022))" -eq 0 ] \
        || fail "Cannot purge through directory $directory that allows non-owner writes (mode $mode)."
}
if [ "${1:-}" = purge ]; then
    if [ -z "${DPKG_ROOT:-}" ]; then
        install_dir=/opt/@QCWS_DEB_BASENAME@
        program_dir=$install_dir/bin
        config_dir=$program_dir/data
        for directory in /opt "$install_dir" "$program_dir" "$config_dir"; do
            check_purge_directory "$directory"
        done
        if [ -d "$config_dir" ]; then
            rm -f -- "$config_dir/runtime.json"
        fi
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper purge "$unit" >/dev/null || true
        fi
    fi
fi
case "${1:-}" in
    remove|purge|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null || true
        fi
        ;;
esac
# Generated tokens, data and the service account remain, preventing loss
# of retained data and later UID reuse.
exit 0
