#!/bin/sh
set -eu
case "${1:-}" in
    configure|abort-upgrade|abort-remove|abort-deconfigure) ;;
    *) exit 0 ;;
esac
if [ -n "${DPKG_ROOT:-}" ]; then
    echo "Configure QCopilots-WebSearch inside the target root using chroot." >&2
    exit 1
fi
account=@QCWS_DEB_ACCOUNT@
unit=@QCWS_DEB_BASENAME@.service
config_dir=/etc/@QCWS_DEB_BASENAME@
config_file=$config_dir/runtime.json
token_file=$config_dir/client.token
admin_token_file=$config_dir/admin.token
state_dir=/var/lib/@QCWS_DEB_BASENAME@
program=/opt/@QCWS_DEB_BASENAME@/bin/qcopilots-websearch
fail() { echo "QCopilots-WebSearch: $1" >&2; exit 1; }
if ! getent passwd "$account" >/dev/null; then
    adduser --system --group --home "$state_dir" --no-create-home --disabled-login "$account"
fi
[ "$(id -u "$account")" -ne 0 ] || fail "The service account must not be root."
[ "$(id -gn "$account")" = "$account" ] || fail "Unexpected primary service group."
for directory in "$config_dir" "$state_dir"; do
    [ ! -L "$directory" ] || fail "A managed directory is a symbolic link."
    if [ -e "$directory" ] && [ ! -d "$directory" ]; then
        fail "A managed directory path is not a directory."
    fi
done
# Never recursively chown retained user data.
install -d -o root -g "$account" -m 0750 "$config_dir"
install -d -o "$account" -g "$account" -m 0700 "$state_dir"
for credential in "$token_file" "$admin_token_file"; do
    if [ -e "$credential" ] || [ -L "$credential" ]; then
        [ -f "$credential" ] && [ ! -L "$credential" ] || fail "Credential is not a regular file."
    fi
done
# Each package initializes only its own version. A reinstall preserves any
# existing runtime and credentials for that version.
if [ ! -e "$config_file" ] && [ ! -L "$config_file" ]; then
    env -u LD_LIBRARY_PATH -u QT_PLUGIN_PATH -u QML2_IMPORT_PATH "$program" \
        --ConfigPath "$config_file" --InitializeConfig --SelectAvailablePorts --StateDirectory "$state_dir"
else
    [ -f "$config_file" ] && [ ! -L "$config_file" ] || fail "Configuration is not a regular file."
fi
chown root:"$account" "$config_file"
chmod 0640 "$config_file"
for credential in "$token_file" "$admin_token_file"; do
    if [ -f "$credential" ]; then
        chown "$account:$account" "$credential"
        chmod 0600 "$credential"
    fi
done
deb-systemd-helper unmask "$unit" >/dev/null || true
if deb-systemd-helper --quiet was-enabled "$unit"; then
    deb-systemd-helper enable "$unit" >/dev/null || true
else
    deb-systemd-helper update-state "$unit" >/dev/null || true
fi
if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
    action=start
    if [ -n "${2:-}" ]; then action=restart; fi
    deb-systemd-invoke "$action" "$unit" >/dev/null || true
fi
exit 0
