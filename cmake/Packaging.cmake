set(CPACK_PACKAGE_NAME QCopilots-WebSearch)
set(CPACK_PACKAGE_VENDOR "QCopilots-WebSearch contributors")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Self-hosted web search and reading for MCP clients")
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_PACKAGE_CONTACT "https://github.com/xiaobing318/QCopilots-WebSearch/issues")
set(CPACK_PACKAGE_INSTALL_DIRECTORY QCopilots-WebSearch)
set(CPACK_VERBATIM_VARIABLES YES)
set(CPACK_PACKAGE_CHECKSUM SHA256)
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
if(WIN32)
  file(READ "${PROJECT_SOURCE_DIR}/LICENSE" _project_license)
  file(READ "${PROJECT_SOURCE_DIR}/packaging/windows/licenses/Microsoft-VC-Runtime.txt" _runtime_license)
  file(WRITE "${PROJECT_BINARY_DIR}/LICENSE.txt"
    "QCopilots-WebSearch source is Apache-2.0. The Apache license below applies to project code.\n\n"
    "Windows packages also contain Microsoft runtime libraries. The separate Microsoft terms after the Apache license apply only to those libraries. Qt and other dependencies retain the licenses included in the package. LGPL library replacement and debugging rights are preserved.\n\n"
    "${_project_license}\n\nMICROSOFT RUNTIME ONLY\n\n${_runtime_license}\n")
  set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_BINARY_DIR}/LICENSE.txt")
  if(CMAKE_VERSION VERSION_LESS 3.30)
    message(FATAL_ERROR "WiX .NET packaging requires CMake 3.30 or newer")
  endif()
  option(QCWS_INSTALLER_TEST_MODE "Use an isolated Windows installer identity" OFF)
  set(_windows_product_namespace "e762d904-722b-4a29-9a31-0546e0ef7691")
  if(QCWS_INSTALLER_TEST_MODE)
    set(CPACK_PACKAGE_NAME "QCopilots-WebSearch-PoC")
    set(QCWS_SERVICE_NAME "QCopilotsWebSearchPoC-${PROJECT_VERSION}")
    string(UUID _windows_product_namespace NAMESPACE "${_windows_product_namespace}"
      NAME "isolated-windows-installer-poc-x64" TYPE SHA1 UPPER)
  else()
    set(QCWS_SERVICE_NAME "QCopilotsWebSearch-${PROJECT_VERSION}")
  endif()
  set(QCWS_DATA_DIRECTORY "${CPACK_PACKAGE_NAME}-${PROJECT_VERSION}")
  set(CPACK_PACKAGE_INSTALL_DIRECTORY "${QCWS_DATA_DIRECTORY}")
  string(UUID CPACK_WIX_UPGRADE_GUID NAMESPACE "${_windows_product_namespace}"
    NAME "version-${PROJECT_VERSION}-x64" TYPE SHA1 UPPER)
  target_compile_definitions(qcopilots-websearch PRIVATE QCWS_WINDOWS_SERVICE_NAME="${QCWS_SERVICE_NAME}"
    QCWS_WINDOWS_DATA_DIRECTORY="${QCWS_DATA_DIRECTORY}")
  execute_process(COMMAND sc.exe showsid "${QCWS_SERVICE_NAME}"
    RESULT_VARIABLE _sid_result OUTPUT_VARIABLE _sid_output ERROR_VARIABLE _sid_error)
  string(REGEX MATCH "S-1-5-80(-[0-9]+)+" QCWS_SERVICE_SID "${_sid_output}")
  if(NOT _sid_result EQUAL 0 OR QCWS_SERVICE_SID STREQUAL "")
    message(FATAL_ERROR "Cannot determine Windows service SID")
  endif()
  string(UUID QCWS_DATA_COMPONENT_GUID NAMESPACE "${CPACK_WIX_UPGRADE_GUID}"
    NAME "programdata-root-v1" TYPE SHA1 UPPER)
  string(UUID QCWS_STATE_COMPONENT_GUID NAMESPACE "${CPACK_WIX_UPGRADE_GUID}"
    NAME "programdata-state-v1" TYPE SHA1 UPPER)
  string(UUID CPACK_WIX_PRODUCT_GUID NAMESPACE "${CPACK_WIX_UPGRADE_GUID}"
    NAME "product-${PROJECT_VERSION}-x64" TYPE SHA1 UPPER)
  file(MAKE_DIRECTORY "${PROJECT_BINARY_DIR}/packaging")
  configure_file("${PROJECT_SOURCE_DIR}/packaging/windows/service-patch.xml.in"
    "${PROJECT_BINARY_DIR}/packaging/service-patch.xml" @ONLY)
  set(CPACK_GENERATOR "ZIP;WIX")
  set(CPACK_WIX_VERSION 4)
  set(CPACK_WIX_ARCHITECTURE x64)
  set(CPACK_WIX_INSTALL_SCOPE perMachine)
  set(CPACK_WIX_BUILD_EXTRA_FLAGS "-acceptEula;wix7")
  set(CPACK_WIX_PATCH_FILE "${PROJECT_BINARY_DIR}/packaging/service-patch.xml")
else()
  set(CPACK_GENERATOR DEB)
  set(CPACK_PACKAGING_INSTALL_PREFIX "/")
  set(CPACK_DEBIAN_PACKAGE_NAME "${QCWS_DEB_BASENAME}")
  set(CPACK_DEBIAN_FILE_NAME "DEB-DEFAULT")
  set(CPACK_DEBIAN_PACKAGE_MAINTAINER "QCopilots-WebSearch contributors")
  set(CPACK_DEBIAN_PACKAGE_SECTION net)
  set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE amd64)
  set(CPACK_DEBIAN_PACKAGE_HOMEPAGE "https://github.com/xiaobing318/QCopilots-WebSearch")
  set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
  set(CPACK_DEBIAN_PACKAGE_DEPENDS "ca-certificates, adduser, init-system-helpers, libssl3t64")
  set(CPACK_DEBIAN_PACKAGE_CONTROL_STRICT_PERMISSION TRUE)
  foreach(_maintainer_script IN ITEMS postinst prerm postrm)
    set(_script_path "${PROJECT_BINARY_DIR}/debian/${_maintainer_script}")
    configure_file("deploy/debian/${_maintainer_script}" "${_script_path}" @ONLY NEWLINE_STYLE UNIX)
    list(APPEND CPACK_DEBIAN_PACKAGE_CONTROL_EXTRA "${_script_path}")
  endforeach()
endif()
include(CPack)
