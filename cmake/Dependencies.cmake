include(FetchContent)
find_package(Qt6 6.12.0 EXACT REQUIRED COMPONENTS Core Network Sql)
get_target_property(_qt_type Qt6::Core TYPE)
if(NOT _qt_type STREQUAL "SHARED_LIBRARY")
  message(FATAL_ERROR "Qt must be dynamically linked")
endif()
set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
macro(qcws_dependency name url sha256)
  FetchContent_Declare(${name} URL "${url}" URL_HASH "SHA256=${sha256}"
    DOWNLOAD_EXTRACT_TIMESTAMP FALSE EXCLUDE_FROM_ALL)
  FetchContent_MakeAvailable(${name})
endmacro()
set(QCWS_DEPENDENCY_PREFIX "" CACHE PATH "Private prefix prepared by the pipeline")
find_package(ZLIB 1.4 EXACT CONFIG REQUIRED COMPONENTS static
  PATHS "${QCWS_DEPENDENCY_PREFIX}/lib/cmake/zlib" NO_DEFAULT_PATH)
if(NOT TARGET ZLIB::ZLIB)
  add_library(ZLIB::ZLIB ALIAS ZLIB::ZLIBSTATIC)
endif()
file(WRITE "${CMAKE_FIND_PACKAGE_REDIRECTS_DIR}/zlib-config.cmake"
  "set(ZLIB_FOUND TRUE)\nset(ZLIB_VERSION 1.4)\nset(ZLIB_VERSION_STRING 1.4)\nset(ZLIB_INCLUDE_DIR \"${QCWS_DEPENDENCY_PREFIX}/include\")\nset(ZLIB_INCLUDE_DIRS \"${QCWS_DEPENDENCY_PREFIX}/include\")\nset(ZLIB_LIBRARY ZLIB::ZLIB)\nset(ZLIB_LIBRARIES ZLIB::ZLIB)\n")
configure_file("${QCWS_DEPENDENCY_PREFIX}/lib/cmake/zlib/ZLIBConfigVersion.cmake"
  "${CMAKE_FIND_PACKAGE_REDIRECTS_DIR}/zlib-config-version.cmake" COPYONLY)
foreach(opt CARES_STATIC CARES_THREADS CARES_STATIC_PIC)
  set(${opt} ON CACHE BOOL "" FORCE)
endforeach()
foreach(opt CARES_SHARED CARES_INSTALL CARES_BUILD_TESTS CARES_BUILD_CONTAINER_TESTS CARES_BUILD_TOOLS CARES_MSVC_STATIC_RUNTIME)
  set(${opt} OFF CACHE BOOL "" FORCE)
endforeach()
qcws_dependency(cares "https://github.com/c-ares/c-ares/releases/download/v1.34.9/c-ares-1.34.9.tar.gz"
  "9364b70a12eb59a06830fb488d9357f90100dff0d98b23ea3593a183d43e6f2f")
set(CARES_USE_STATIC_LIBS ON)
set(CARES_INCLUDE_DIR "${cares_SOURCE_DIR}/include")
set(CARES_LIBRARY c-ares::cares_static)
foreach(opt BUILD_CURL_EXE BUILD_STATIC_CURL BUILD_EXAMPLES BUILD_TESTING BUILD_LIBCURL_DOCS BUILD_MISC_DOCS
  ENABLE_CURL_MANUAL CURL_BUILD_EVERYTHING CURL_ENABLE_EXPORT_TARGET PICKY_COMPILER CURL_STATIC_CRT
  ENABLE_THREADED_RESOLVER CURL_USE_CMAKECONFIG CURL_USE_PKGCONFIG CURL_USE_LIBPSL CURL_USE_LIBSSH2
  CURL_USE_LIBSSH CURL_USE_GSASL CURL_USE_GSSAPI CURL_USE_LIBBACKTRACE CURL_USE_LIBUV USE_LIBIDN2
  USE_WIN32_IDN USE_NGHTTP2 USE_NGTCP2 USE_QUICHE USE_HTTPSRR USE_ECH USE_SSLS_EXPORT USE_PROXY_HTTP3
  ENABLE_UNIX_SOCKETS CURL_USE_MBEDTLS CURL_USE_WOLFSSL CURL_USE_GNUTLS CURL_USE_RUSTLS)
  set(${opt} OFF CACHE BOOL "" FORCE)
endforeach()
foreach(opt BUILD_STATIC_LIBS CURL_DISABLE_INSTALL ENABLE_ARES CURL_ENABLE_SSL)
  set(${opt} ON CACHE BOOL "" FORCE)
endforeach()
set(CURL_ZLIB ON CACHE STRING "" FORCE)
set(CURL_BROTLI OFF CACHE STRING "" FORCE)
set(CURL_ZSTD OFF CACHE STRING "" FORCE)
if(WIN32)
  set(CURL_USE_SCHANNEL ON CACHE BOOL "" FORCE)
  set(CURL_USE_OPENSSL OFF CACHE BOOL "" FORCE)
else()
  set(OPENSSL_USE_STATIC_LIBS TRUE)
  find_package(OpenSSL REQUIRED COMPONENTS SSL Crypto)
  set(CURL_USE_SCHANNEL OFF CACHE BOOL "" FORCE)
  set(CURL_USE_OPENSSL ON CACHE BOOL "" FORCE)
endif()
foreach(proto FILE FTP LDAP LDAPS DICT GOPHER IMAP MQTT POP3 RTSP SMTP TELNET TFTP WEBSOCKETS IPFS NETRC DOH COOKIES ALTSVC HSTS)
  set(CURL_DISABLE_${proto} ON CACHE BOOL "" FORCE)
endforeach()
qcws_dependency(curl "https://github.com/curl/curl/releases/download/curl-8_23_0/curl-8.23.0.tar.xz"
  "8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5")
foreach(dep OPENSSL WOLFSSL MBEDTLS ZLIB BROTLI ZSTD)
  set(HTTPLIB_REQUIRE_${dep} OFF CACHE BOOL "" FORCE)
  set(HTTPLIB_USE_${dep}_IF_AVAILABLE OFF CACHE BOOL "" FORCE)
endforeach()
foreach(opt HTTPLIB_COMPILE HTTPLIB_INSTALL HTTPLIB_TEST HTTPLIB_BUILD_MODULES)
  set(${opt} OFF CACHE BOOL "" FORCE)
endforeach()
