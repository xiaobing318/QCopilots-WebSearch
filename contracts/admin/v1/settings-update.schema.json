{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "patch": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "object",
          "properties": {
            "search": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "open": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "search_without_asking": {
          "type": "boolean"
        },
        "search": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "auto",
                "searxng",
                "brave",
                "tavily",
                "exa",
                "perplexity",
                "deepseek"
              ]
            },
            "searxng": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "engines": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "minItems": 1,
                  "maxItems": 20,
                  "uniqueItems": true
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "revision",
    "patch"
  ],
  "additionalProperties": false
}
